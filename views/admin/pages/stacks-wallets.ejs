<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Stacks Wallets — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 .sw-table { width:100%; border-collapse:collapse; font-size:.875rem }
 .sw-table th { text-align:left; padding:.625rem 1rem; font-size:.7rem; font-weight:800; letter-spacing:.8px; text-transform:uppercase; color:var(--text-3); border-bottom:1px solid var(--border) }
 .sw-table td { padding:.75rem 1rem; border-bottom:1px solid rgba(255,255,255,.04); vertical-align:middle }
 .sw-table tr:last-child td { border-bottom:none }
 .sw-table tr:hover td { background:rgba(255,255,255,.02) }
 .sw-addr { font-family:monospace; font-size:.78rem; color:#60a5fa }
 .sw-bal { font-weight:800; color:#5EC213 }
 .sw-zero { color:var(--text-3) }
 .sw-badge { display:inline-block; font-size:.7rem; font-weight:800; padding:.2rem .6rem; border-radius:6px; background:rgba(94,194,19,.1); color:#5EC213; border:1px solid rgba(94,194,19,.2) }
 .sw-actions { display:flex; gap:.5rem }
 .sw-btn { display:inline-flex; align-items:center; gap:.375rem; padding:.4rem .875rem; border-radius:8px; font-size:.78rem; font-weight:700; cursor:pointer; border:1px solid; font-family:inherit; transition:opacity .15s }
 .sw-btn:hover { opacity:.8 }
 .sw-btn-refresh { background:rgba(96,165,250,.1); border-color:rgba(96,165,250,.25); color:#60a5fa }
 .sw-btn-sweep { background:rgba(94,194,19,.1); border-color:rgba(94,194,19,.25); color:#5EC213 }
 .sw-btn-sweep:disabled { opacity:.35; cursor:not-allowed }
 .sw-stat { background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:1.25rem 1.5rem }
 .sw-stat-val { font-size:1.75rem; font-weight:900; color:var(--text) }
 .sw-stat-lbl { font-size:.75rem; font-weight:700; color:var(--text-3); margin-top:.25rem; text-transform:uppercase; letter-spacing:.5px }
 .sw-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; margin-bottom:1.5rem }
 .sw-empty { text-align:center; padding:3rem; color:var(--text-3); font-size:.875rem }
 </style>
</head>
<body>
<div class="a-bg"></div>
<%- include('../partials/nav', { page:'stacks-wallets', admin:user }) %>

<div class="a-main">
 <div class="a-content" style="max-width:1100px">
 <div class="a-page-header">
 <div>
 <h1><i class="fas fa-wallet" style="color:#f7931a"></i> Stacks Wallets</h1>
 <p>Custodial STX wallets generated for ZeroAuthDAO bounty submissions — sweep rewards to your main wallet</p>
 </div>
 <div style="display:flex;gap:.75rem;flex-wrap:wrap">
 <button id="refreshAllBtn" onclick="refreshAll(this)" class="a-btn a-btn-primary" style="min-width:180px">
 <i class="fas fa-rotate"></i> Refresh All Wallets
 </button>
 </div>
 </div>

 <!-- Stats -->
 <div class="sw-grid">
 <div class="sw-stat">
 <div class="sw-stat-val" id="statWallets"><%= users.length %></div>
 <div class="sw-stat-lbl">Total Wallets</div>
 </div>
 <div class="sw-stat">
 <div class="sw-stat-val" id="statSTX" style="color:#f7931a">
 <%= (users.reduce((s,u)=>s+(u.stacksBalance||0),0)/1_000_000).toFixed(2) %> STX
 </div>
 <div class="sw-stat-lbl">Total Balance</div>
 </div>
 <div class="sw-stat">
 <div class="sw-stat-val" id="statUSD" style="color:#5EC213">
 $<%= users.reduce((s,u)=>s+(u.stacksBalanceUSD||0),0).toFixed(2) %>
 </div>
 <div class="sw-stat-lbl">Total USD Value</div>
 </div>
 <div class="sw-stat">
 <div class="sw-stat-val" style="color:#fbbf24">$<%= stxPrice.toFixed(4) %></div>
 <div class="sw-stat-lbl">STX Price (CoinGecko)</div>
 </div>
 </div>

 <!-- Fee Wallet -->
 <% if (feeWallet) { %>
 <div class="a-card" style="margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
 <div>
 <div style="font-size:.7rem;font-weight:900;letter-spacing:1px;text-transform:uppercase;color:var(--text-3);margin-bottom:.375rem">ONBOARD3 Fee Wallet <span style="color:#f7931a;margin-left:.5rem">pays gas for all submissions</span></div>
 <div style="font-family:monospace;font-size:.875rem;color:#60a5fa;margin-bottom:.375rem"><%= feeWallet.address %></div>
 <div style="display:flex;gap:1.5rem;flex-wrap:wrap">
 <span style="font-size:.875rem;font-weight:800;color:<%= feeWallet.stx < 1 ? '#f87171' : '#5EC213' %>">
 <%= feeWallet.stx.toFixed(4) %> STX
 </span>
 <span style="font-size:.875rem;color:var(--text-3)">≈ $<%= feeWallet.usd.toFixed(2) %></span>
 <span style="font-size:.78rem;color:var(--text-3)">~<%= Math.floor(feeWallet.microSTX / 3000).toLocaleString() %> submissions remaining</span>
 </div>
 <% if (feeWallet.stx < 1) { %>
 <div style="margin-top:.5rem;font-size:.78rem;color:#f87171;font-weight:700"><i class="fas fa-triangle-exclamation"></i> Low balance — send more STX to keep submissions working</div>
 <% } %>
 </div>
 <button onclick="navigator.clipboard.writeText('<%= feeWallet.address %>').then(()=>aToast('Address copied'))" class="a-btn" style="white-space:nowrap"><i class="fas fa-copy"></i> Copy Address</button>
 </div>
 <% } %>

 <!-- Environment check -->
 <% if (!hasSeed || !hasMainWallet) { %>
 <div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.25);border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.25rem;display:flex;gap:.75rem;align-items:flex-start">
 <i class="fas fa-triangle-exclamation" style="color:#f87171;margin-top:.15rem"></i>
 <div>
 <div style="color:#f87171;font-weight:800;font-size:.875rem;margin-bottom:.25rem">Missing environment variables</div>
 <div style="color:#aaa;font-size:.8125rem;line-height:1.6">
 <% if (!hasSeed) { %>
 <div>• <code style="color:#f87171">STACKS_MASTER_SEED</code> — configure a securely generated recovery phrase outside this repository; never commit it</div>
 <% } %>
 <% if (!hasMainWallet) { %>
 <div>• <code style="color:#f87171">STACKS_MAIN_WALLET</code> — your personal Stacks address where all sweep funds land</div>
 <% } %>
 </div>
 </div>
 </div>
 <% } %>

 <!-- Wallets table -->
 <div class="a-card" style="padding:0;overflow:hidden">
 <% if (users.length === 0) { %>
 <div class="sw-empty">
 <i class="fas fa-wallet" style="font-size:2rem;margin-bottom:.75rem;display:block;color:var(--text-3)"></i>
 No custodial wallets created yet.<br>Wallets are auto-generated when users submit a ZeroAuthDAO bounty.
 </div>
 <% } else { %>
 <div style="overflow-x:auto">
 <table class="sw-table">
 <thead>
 <tr>
 <th>#</th>
 <th>User</th>
 <th>Stacks Address</th>
 <th>STX Balance</th>
 <th>USDCx Balance</th>
 <th>USD Value</th>
 <th>Last Checked</th>
 <th>Actions</th>
 </tr>
 </thead>
 <tbody id="walletsBody">
 <% users.forEach(function(u, i) {
 var stx = (u.stacksBalance || 0) / 1_000_000;
 var usd = u.stacksBalanceUSD || 0;
 var usdcx = Number(u.usdcxBalance || 0) / 1_000_000;
 var hasSTX = u.stacksBalance > 0;
 var hasBalance = u.stacksBalance > 0 || u.usdcxBalance > 0;
 %>
 <tr id="row-<%= u._id %>">
 <td style="color:var(--text-3);font-size:.78rem"><%= u.stacksWalletIndex %></td>
 <td>
 <div style="font-weight:800;font-size:.875rem"><%= u.username %></div>
 <div style="font-size:.75rem;color:var(--text-3)"><%= u.email %></div>
 </td>
 <td>
 <span class="sw-addr"><%= u.stacksAddress %></span>
 <button onclick="copyAddr('<%= u.stacksAddress %>')" style="background:none;border:none;cursor:pointer;color:var(--text-3);padding:.1rem .3rem;margin-left:.25rem;font-size:.75rem" title="Copy"><i class="fas fa-copy"></i></button>
 </td>
 <td>
 <span class="<%= hasSTX ? 'sw-bal' : 'sw-zero' %>">
 <%= stx.toFixed(6) %> STX
 </span>
 </td>
 <td><span class="<%= usdcx > 0 ? 'sw-bal' : 'sw-zero' %>"><%= usdcx.toFixed(6) %> USDCx</span></td>
 <td>
 <span class="<%= hasBalance ? 'sw-bal' : 'sw-zero' %>">
 $<%= usd.toFixed(2) %>
 </span>
 </td>
 <td style="font-size:.78rem;color:var(--text-3)">
 <%= u.stacksCheckedAt ? new Date(u.stacksCheckedAt).toLocaleString() : 'Never' %>
 </td>
 <td>
 <div class="sw-actions">
 <button class="sw-btn sw-btn-refresh" onclick="refreshOne('<%= u._id %>', this)" title="Refresh balance">
 <i class="fas fa-rotate"></i>
 </button>
 <button class="sw-btn sw-btn-sweep <%= !hasBalance ? 'disabled' : '' %>"
 <%= !hasBalance ? 'disabled' : '' %>
 onclick="sweep('<%= u._id %>', '<%= u.username %>', this)"
 title="Sweep to main wallet">
 <i class="fas fa-arrow-right-arrow-left"></i> Sweep
 </button>
 </div>
 </td>
 </tr>
 <% }); %>
 </tbody>
 </table>
 </div>
 <% } %>
 </div>

 </div>
</div>

<script>
var _pollTimer = null;

function copyAddr(addr) {
 navigator.clipboard.writeText(addr).then(() => aToast('Address copied'));
}

function refreshOne(userId, btn) {
 var orig = btn.innerHTML;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
 btn.disabled = true;
 fetch('/admin/stacks-wallets/refresh', {
  method: 'POST', headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ userId })
 }).then(function(r) { return r.json(); }).then(function(d) {
  btn.innerHTML = orig;
  btn.disabled = false;

  if (d.success) {
   applyJobResults(d);
   aToast('Balance updated');
  } else {
   aToast(d.message || 'Failed', 'error');
  }
 }).catch(function() { btn.innerHTML = orig; btn.disabled = false; aToast('Network error', 'error'); });
}

function refreshAll(btn) {
 if (!btn) btn = document.getElementById('refreshAllBtn');
 var origHtml = '<i class="fas fa-rotate"></i> Refresh All Wallets';
 fetch('/admin/stacks-wallets/refresh', {
  method: 'POST', headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({})
 }).then(function(r) { return r.json(); }).then(function(d) {
  if (!d.success) { aToast(d.message || 'Failed to start', 'error'); return; }
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Refreshing…';
  if (d.alreadyRunning) {
   aToast('Refresh is already running in background');
  } else {
   aToast('Refresh started — running in background (8s per wallet)');
  }
  showProgressBanner();
  startPolling(btn, origHtml);
 }).catch(function() { aToast('Network error', 'error'); });
}

function showProgressBanner() {
 if (document.getElementById('_swProg')) return;
 var el = document.createElement('div');
 el.id = '_swProg';
 el.style.cssText = 'position:fixed;bottom:1.25rem;right:1.25rem;background:#111827;border:1px solid var(--border);border-radius:14px;padding:1rem 1.25rem;min-width:290px;z-index:9999;box-shadow:0 8px 32px rgba(0,0,0,.6)';
 el.innerHTML = '<div style="font-size:.7rem;font-weight:900;text-transform:uppercase;letter-spacing:.8px;color:var(--text-3);margin-bottom:.5rem">Background Refresh</div>'
  + '<div id="_swProgTxt" style="font-size:.875rem;font-weight:700;color:var(--text);margin-bottom:.5rem">Starting…</div>'
  + '<div style="background:rgba(255,255,255,.07);border-radius:6px;height:8px;overflow:hidden">'
  + '<div id="_swProgBar" style="height:100%;background:linear-gradient(90deg,#5EC213,#84e040);border-radius:6px;transition:width .5s ease;width:0%"></div></div>'
  + '<div id="_swProgSub" style="font-size:.75rem;color:var(--text-3);margin-top:.375rem">&nbsp;</div>';
 document.body.appendChild(el);
}

function hideProgressBanner() {
 var el = document.getElementById('_swProg');
 if (el) { el.style.opacity = '0'; el.style.transition = 'opacity .4s ease'; setTimeout(function() { el.remove(); }, 450); }
}

function updateProgressBanner(d) {
 var pct = d.total > 0 ? Math.round((d.done / d.total) * 100) : 0;
 var bar = document.getElementById('_swProgBar');
 var txt = document.getElementById('_swProgTxt');
 var sub = document.getElementById('_swProgSub');
 if (bar) bar.style.width = pct + '%';
 if (txt) txt.textContent = 'Checking ' + d.done + ' / ' + (d.total || '?') + ' wallets (' + pct + '%)';
 if (sub) {
  var parts = [];
  if (d.updated) parts.push('<span style="color:#5EC213">' + d.updated + ' updated</span>');
  if (d.failed)  parts.push('<span style="color:#f87171">' + d.failed + ' failed</span>');
  if (d.stxPrice) parts.push('STX $' + Number(d.stxPrice).toFixed(4));
  sub.innerHTML = parts.join(' · ') || '&nbsp;';
 }
}

function applyJobResults(d) {
 var totalSTX = 0, totalUSD = 0;
 (d.wallets || []).forEach(function(w) {
  var row = document.getElementById('row-' + w.id);
  if (!row) return;
  var usdcxBalance = Number(w.usdcxBalance || 0);
  var hasBalance = w.microSTX > 0 || usdcxBalance > 0;
  var stxCls = w.microSTX > 0 ? 'sw-bal' : 'sw-zero';
  var cls = Number(w.usd) > 0 ? 'sw-bal' : 'sw-zero';
  var stxCell = row.cells[3], usdcxCell = row.cells[4], usdCell = row.cells[5], chkCell = row.cells[6];
  var sweepBtn = row.querySelector('.sw-btn-sweep');
  if (stxCell) stxCell.innerHTML = '<span class="' + stxCls + '">' + Number(w.stx).toFixed(6) + ' STX</span>';
  if (usdcxCell) usdcxCell.innerHTML = '<span class="' + (usdcxBalance > 0 ? 'sw-bal' : 'sw-zero') + '">' + (usdcxBalance / 1000000).toFixed(6) + ' USDCx</span>';
  if (usdCell) usdCell.innerHTML = '<span class="' + cls + '">$' + Number(w.usd).toFixed(2) + '</span>';
  if (chkCell) chkCell.textContent = new Date(w.checkedAt).toLocaleString();
  if (sweepBtn) { sweepBtn.disabled = !hasBalance; sweepBtn.classList.toggle('disabled', !hasBalance); }
  totalSTX += Number(w.stx); totalUSD += Number(w.usd);
 });
 (d.errors || []).forEach(function(e) {
  var row = document.getElementById('row-' + e.id);
  if (!row) return;
  var chkCell = row.cells[6];
  if (chkCell) chkCell.innerHTML = '<span style="color:#f87171;font-size:.75rem"><i class="fas fa-triangle-exclamation"></i> API failed</span>';
 });
 var stxEl = document.getElementById('statSTX'), usdEl = document.getElementById('statUSD');
 if (stxEl && totalSTX > 0) stxEl.textContent = totalSTX.toFixed(2) + ' STX';
 if (usdEl && totalUSD > 0) usdEl.textContent = '$' + totalUSD.toFixed(2);
}

function startPolling(btn, origHtml) {
 if (_pollTimer) clearInterval(_pollTimer);
 _pollTimer = setInterval(function() {
  fetch('/admin/stacks-wallets/refresh-status')
   .then(function(r) { return r.json(); })
   .then(function(d) {
    if (!d.success) return;
    updateProgressBanner(d);
    applyJobResults(d);
    if (!d.running) {
     clearInterval(_pollTimer); _pollTimer = null;
     if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
     setTimeout(hideProgressBanner, 3000);
     var fc = d.failed || 0;
     aToast((d.updated || 0) + ' / ' + (d.total || 0) + ' wallets refreshed' + (fc > 0 ? ' (' + fc + ' failed)' : ''), fc > 0 ? 'error' : 'success');
    }
   }).catch(function() { /* ignore transient errors */ });
 }, 3000);
}

function sweep(userId, username, btn) {
 if (!confirm('Sweep ' + username + "'s wallet to your main Stacks address?\n\nSTX and USDCx will be transferred. USDCx gas is paid by the ONBOARD3 fee wallet.\nThe existing STX-to-USDC balance credit rule stays the same.")) return;
 var orig = btn.innerHTML;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sweeping...';
 btn.disabled = true;
 fetch('/admin/stacks-wallets/sweep/' + userId, {
  method: 'POST', headers: { 'Content-Type': 'application/json' }
 }).then(function(r) { return r.json(); }).then(function(d) {
  btn.innerHTML = orig;
  if (d.success && d.pending) {
   aToast('USDCx sweep submitted; waiting for on-chain confirmation. The user balance will update only after success.');
   setTimeout(function() { location.reload(); }, 2000);
   return;
  }
  if (d.success) {
   var tokenCount = (d.sweptTokens || []).length;
   var txCount = (d.txIds || [d.txId]).length;
   aToast(username + ' swept: ' + Number(d.usdcxCredit || 0).toFixed(2) + ' USDCx credited, ' + Number(d.totalSTX || 0).toFixed(6) + ' STX; $' + Number(d.userCredit || 0).toFixed(2) + ' STX credit across ' + txCount + ' tx(s)');
   if ((d.errors || []).length) aToast('Some assets were not swept: ' + d.errors.map(function(e) { return e.assetId + ': ' + e.message; }).join('; '), 'error');
   setTimeout(function() { location.reload(); }, 1500);
  } else {
   btn.disabled = false;
   aToast(d.message || 'Sweep failed', 'error');
  }
 });
}

// If a job is already running when the page loads, resume the progress banner
document.addEventListener('DOMContentLoaded', function() {
 fetch('/admin/stacks-wallets/refresh-status')
  .then(function(r) { return r.json(); })
  .then(function(d) {
   if (!d.running) return;
   var btn = document.getElementById('refreshAllBtn');
   if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Refreshing…'; }
   applyJobResults(d);
   showProgressBanner();
   updateProgressBanner(d);
   startPolling(btn, '<i class="fas fa-rotate"></i> Refresh All Wallets');
  }).catch(function() {});
});
</script>
<%- include('../../partials/whatsapp-float') %>
</body>
</html>
