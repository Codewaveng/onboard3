<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
 <title>Leaderboard Manager — ONBOARD3 Admin</title>
 <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
 <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
 <link rel="stylesheet" href="/css/admin.css">
 <style>
 .lb-selector { display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap; }
 .lb-selector label { font-size:.78rem;font-weight:800;color:var(--text-3);text-transform:uppercase;letter-spacing:1px;white-space:nowrap; }
 .lb-rank-cell { display:flex;align-items:center;gap:.625rem; }
 .rank-num { width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.8125rem;font-weight:900; }
 .rank-1 { background:rgba(255,215,0,.15);color:#FFD700; }
 .rank-2 { background:rgba(192,192,192,.12);color:#C0C0C0; }
 .rank-3 { background:rgba(205,127,50,.12);color:#CD7F32; }
 .rank-x { background:rgba(255,255,255,.06);color:var(--text-3); }
 .loading { text-align:center;padding:3rem;color:var(--text-3);font-size:.875rem; }
 .loading i { font-size:1.5rem;display:block;margin-bottom:.5rem; }
 .form-group { margin-bottom:1.125rem; }
 .form-label { display:block;font-size:.72rem;font-weight:800;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.4rem; }
 .form-input { width:100%;padding:.8rem 1rem;background:rgba(94,194,19,.04);border:1.5px solid var(--border);border-radius:10px;color:var(--text);font-family:'Outfit',sans-serif;font-size:.9rem;transition:all .25s; }
 .form-input:focus { outline:none;border-color:var(--green);background:rgba(94,194,19,.07);box-shadow:0 0 0 3px rgba(94,194,19,.12); }
 </style>
</head>
<body>
<div class="a-bg"></div>
<%- include('partials/nav', { page:'leaderboard', admin:user }) %>
<div class="a-main"><div class="a-content">

 <!-- Header -->
 <div class="a-page-header"><div><h1><i class="fas fa-ranking-star"></i> Leaderboard Manager</h1><p>Manage leaderboards and user rankings</p></div><div style="display:flex;gap:.5rem"><button class="a-btn a-btn-secondary" id="referralAuditBtn" onclick="openReferralAudit()" style="display:none"><i class="fas fa-search"></i> Referral Audit</button><button class="a-btn a-btn-primary" onclick="openAddModal()"><i class="fas fa-plus"></i> Add User</button></div></div>
<!-- Leaderboard Selector -->
 <div class="lb-selector">
 <label class="lb-selector label">
 <i class="fas fa-list"></i> Select Leaderboard
 </label>
 <select class="a-input" style="width:auto;min-width:260px" id="leaderboardSelect" onchange="loadLeaderboard()">
 <option value="global">Global XP Leaderboard</option>
 <% quests.forEach(quest => { %>
 <option value="<%= quest._id %>"><%= quest.title %> Quest</option>
 <% }); %>
 </select>
 </div>

 <!-- Leaderboard Table -->
 <div class="a-card">
 <div id="loadingIndicator" class="loading">
 <i class="fas fa-spinner fa-spin"></i> Loading leaderboard...
 </div>
 <table id="leaderboardTable" class="at" style="display: none;">
 <thead>
 <tr>
 <th style="width: 80px;">Rank</th>
 <th>Username</th>
 <th>Points</th>
 <th>Type</th>
 <th style="width: 200px;">Actions</th>
 </tr>
 </thead>
 <tbody id="leaderboardBody">
 <!-- Populated by JavaScript -->
 </tbody>
 </table>
 </div>
 </div>

 <!-- Add/Edit User Modal -->
 <div id="userModal" class="a-modal-overlay">
 <div class="a-modal" style="max-width:460px">
 <div class="a-modal-header">
 <h2 style="font-size:1.0625rem;font-weight:800;color:var(--text)" id="modalTitle">Add User</h2>
 <button class="a-modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
 </div>
 <form id="userForm">
 <input type="hidden" id="userId" name="userId">
 <input type="hidden" id="leaderboardType" name="leaderboardType">
 <input type="hidden" id="modalAction" value="set">

 <div class="form-group">
 <label class="form-label">Username</label>
 <input type="text" class="form-input" id="username" name="username" required>
 </div>

 <!-- Edit mode: current XP + add/deduct controls -->
 <div id="editControls" style="display:none">
 <div style="background:rgba(94,194,19,.06);border:1px solid rgba(94,194,19,.2);border-radius:10px;padding:.875rem 1rem;margin-bottom:1rem;display:flex;align-items:center;justify-content:space-between">
 <span style="font-size:.75rem;font-weight:700;color:#8aaf85;text-transform:uppercase;letter-spacing:.05em">Current XP</span>
 <span id="currentXpDisplay" style="font-size:1.25rem;font-weight:900;color:#5ec213">0</span>
 </div>

 <!-- Mode tabs -->
 <div style="display:flex;gap:.375rem;margin-bottom:.875rem">
 <button type="button" id="modeAdd" onclick="setMode('add')" style="flex:1;padding:.5rem;border-radius:8px;font-size:.8rem;font-weight:700;cursor:pointer;transition:all .15s;border:1px solid rgba(94,194,19,.4);background:rgba(94,194,19,.12);color:#5ec213;font-family:Outfit,sans-serif"><i class="fas fa-plus"></i> Add</button>
 <button type="button" id="modeDeduct" onclick="setMode('deduct')" style="flex:1;padding:.5rem;border-radius:8px;font-size:.8rem;font-weight:700;cursor:pointer;transition:all .15s;border:1px solid rgba(255,255,255,.1);background:transparent;color:#8aaf85;font-family:Outfit,sans-serif"><i class="fas fa-minus"></i> Deduct</button>
 <button type="button" id="modeSet" onclick="setMode('set')" style="flex:1;padding:.5rem;border-radius:8px;font-size:.8rem;font-weight:700;cursor:pointer;transition:all .15s;border:1px solid rgba(255,255,255,.1);background:transparent;color:#8aaf85;font-family:Outfit,sans-serif"><i class="fas fa-equals"></i> Set to</button>
 </div>

 <div class="form-group" style="margin-bottom:.5rem">
 <label class="form-label" id="amountLabel">Amount to Add</label>
 <input type="number" class="form-input" id="points" name="points" min="0" required placeholder="Enter amount" style="font-size:1.1rem;font-weight:700;text-align:center">
 </div>

 <div id="previewRow" style="display:none;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:.625rem 1rem;margin-bottom:.875rem;text-align:center;font-size:.875rem;color:#8aaf85">
 New total: <strong id="previewTotal" style="color:#e8f5e2;font-size:1rem"></strong>
 </div>
 </div>

 <!-- Add mode: just a plain XP field -->
 <div id="addControls">
 <div class="form-group">
 <label class="form-label">Starting XP</label>
 <input type="number" class="form-input" id="pointsAdd" min="0" value="0">
 </div>
 </div>

 <div class="form-group" id="fakeUserCheckbox">
 <label class="checkbox-label" style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
 <input type="checkbox" id="isFakeUser" name="isFakeUser" checked disabled>
 <span style="font-size:.85rem">New names are leaderboard-only profiles</span>
 </label>
 </div>

 <button type="submit" class="a-btn a-btn-primary" style="width:100%" id="submitBtn">
 <i class="fas fa-save"></i> Save
 </button>
 </form>
 </div>
 </div>

 <!-- Referral Audit Modal -->
 <div id="referralAuditModal" class="a-modal-overlay">
 <div class="a-modal" style="max-width: 900px;">
 <div class="a-modal-header">
 <h2 style="font-size:1.0625rem;font-weight:800;color:var(--text)"><i class="fas fa-search"></i> Referral Audit</h2>
 <button class="a-modal-close" onclick="closeReferralAuditModal()"><i class="fas fa-times"></i></button>
 </div>

 <div id="auditLoading" class="loading">
 <i class="fas fa-spinner fa-spin"></i> Loading referral data...
 </div>

 <div id="auditContent" style="display: none;">
 <!-- Overall Stats -->
 <div class="audit-stats" id="auditStats"></div>

 <!-- User List with Referrals -->
 <h3 style="color: #39FF14; margin-bottom: 1rem;"><i class="fas fa-users"></i> Users with Referral Bonuses</h3>
 <div class="audit-user-list" id="auditUserList"></div>
 </div>
 </div>
 </div>

 <!-- Individual User Referrals Modal -->
 <div id="userReferralsModal" class="modal">
 <div class="a-modal" style="max-width: 700px;">
 <div class="a-modal-header">
 <h2 style="font-size:1.0625rem;font-weight:800;color:var(--text)" id="userReferralsTitle"><i class="fas fa-user-friends"></i> User Referrals</h2>
 <button class="a-modal-close" onclick="closeUserReferralsModal()"><i class="fas fa-times"></i></button>
 </div>

 <div id="userReferralsLoading" class="loading">
 <i class="fas fa-spinner fa-spin"></i> Loading referral details...
 </div>

 <div id="userReferralsContent" style="display: none;">
 <!-- Summary -->
 <div class="audit-stats" id="userReferralStats"></div>

 <!-- Referrals Joined -->
 <h4 style="color: #39FF14; margin: 1rem 0 0.5rem;"><i class="fas fa-sign-in-alt"></i> Referrals Joined (<span id="joinedCount">0</span>)</h4>
 <div class="referral-list" id="referralsJoinedList"></div>

 <!-- Referrals Completed -->
 <h4 style="color: #00D9FF; margin: 1rem 0 0.5rem;"><i class="fas fa-check-circle"></i> Referrals Completed (<span id="completedCount">0</span>)</h4>
 <div class="referral-list" id="referralsCompletedList"></div>
 </div>
 </div>
 </div>

 <script>
 let currentLeaderboard = 'global';
 let currentData = [];

 // Load leaderboard on page load
 document.addEventListener('DOMContentLoaded', () => {
 loadLeaderboard();
 });

 async function loadLeaderboard() {
 const select = document.getElementById('leaderboardSelect');
 currentLeaderboard = select.value;

 const loadingIndicator = document.getElementById('loadingIndicator');
 const table = document.getElementById('leaderboardTable');

 loadingIndicator.style.display = 'block';
 table.style.display = 'none';

 try {
 const response = await fetch(`/admin/api/leaderboard/data?type=${currentLeaderboard}`);
 const result = await response.json();

 if (result.success) {
 currentData = result.data;
 renderLeaderboard(result.data);
 table.style.display = 'table';
 } else {
 alert(result.message || 'Error loading leaderboard');
 }
 } catch (error) {
 console.error('Error:', error);
 alert('Network error. Please try again.');
 } finally {
 loadingIndicator.style.display = 'none';
 }
 }

 function renderLeaderboard(data) {
 const tbody = document.getElementById('leaderboardBody');
 tbody.innerHTML = '';

 if (data.length === 0) {
 tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #888; padding: 2rem;">No users on this leaderboard yet</td></tr>';
 return;
 }

 data.forEach((user, index) => {
 const row = document.createElement('tr');
 row.dataset.userId = user._id;

 const rankClass = index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : 'rank-other';

 row.innerHTML = `
 <td>
 <div class="rank-badge ${rankClass}">
 #${index + 1}
 </div>
 </td>
 <td>
 ${user.username}
 ${user.isFakeUser ? '<span class="fake-badge">FAKE</span>' : ''}
 </td>
 <td><strong>${(user.points || 0).toLocaleString()}</strong> ${currentLeaderboard === 'global' ? 'XP' : 'Points'}</td>
 <td>${user.isFakeUser ? 'Fake User' : 'Real User'}</td>
 <td>
 <button class="a-btn a-btn-secondary a-btn-sm" onclick="openEditModal('${user._id}', '${user.username}', ${user.points || 0}, ${user.isFakeUser || false})">
 <i class="fas fa-edit"></i> Edit
 </button>
 ${user.isFakeUser ? `
 <button class="a-btn a-btn-danger a-btn-sm" onclick="deleteUser('${user._id}')">
 <i class="fas fa-trash"></i> Delete
 </button>
 ` : ''}
 </td>
 `;

 tbody.appendChild(row);
 });
 }

 var _editCurrentXp = 0;

 function setMode(mode) {
 document.getElementById('modalAction').value = mode;
 var labels = { add: 'Amount to Add', deduct: 'Amount to Deduct', set: 'Set XP to' };
 document.getElementById('amountLabel').textContent = labels[mode];
 ['add','deduct','set'].forEach(function(m) {
 var btn = document.getElementById('mode' + m.charAt(0).toUpperCase() + m.slice(1));
 var active = m === mode;
 btn.style.background = active ? (m === 'deduct' ? 'rgba(239,68,68,.15)' : 'rgba(94,194,19,.12)') : 'transparent';
 btn.style.borderColor = active ? (m === 'deduct' ? 'rgba(239,68,68,.4)' : 'rgba(94,194,19,.4)') : 'rgba(255,255,255,.1)';
 btn.style.color = active ? (m === 'deduct' ? '#ef4444' : '#5ec213') : '#8aaf85';
 });
 updatePreview();
 }

 function updatePreview() {
 var mode = document.getElementById('modalAction').value;
 var amt = parseInt(document.getElementById('points').value) || 0;
 var cur = _editCurrentXp;
 var newVal;
 if (mode === 'add') newVal = cur + amt;
 else if (mode === 'deduct') newVal = Math.max(0, cur - amt);
 else newVal = amt;
 var preview = document.getElementById('previewRow');
 var total = document.getElementById('previewTotal');
 if (amt > 0 || mode === 'set') {
 preview.style.display = 'block';
 total.textContent = newVal.toLocaleString() + ' XP';
 total.style.color = newVal < cur ? '#ef4444' : '#5ec213';
 } else {
 preview.style.display = 'none';
 }
 }

 function openAddModal() {
 document.getElementById('modalTitle').textContent = 'Add User to Leaderboard';
 document.getElementById('userForm').reset();
 document.getElementById('userId').value = '';
 document.getElementById('leaderboardType').value = currentLeaderboard;
 document.getElementById('fakeUserCheckbox').style.display = 'block';
 document.getElementById('editControls').style.display = 'none';
 document.getElementById('addControls').style.display = 'block';
 document.getElementById('userModal').classList.add('open');
 }

 function openEditModal(userId, username, points, isFakeUser) {
 _editCurrentXp = points || 0;
 document.getElementById('modalTitle').textContent = 'Adjust XP — @' + username;
 document.getElementById('userId').value = userId;
 document.getElementById('username').value = username;
 document.getElementById('username').disabled = true;
 document.getElementById('points').value = '';
 document.getElementById('isFakeUser').checked = isFakeUser;
 document.getElementById('leaderboardType').value = currentLeaderboard;
 document.getElementById('fakeUserCheckbox').style.display = 'none';
 document.getElementById('editControls').style.display = 'block';
 document.getElementById('addControls').style.display = 'none';
 document.getElementById('currentXpDisplay').textContent = (points || 0).toLocaleString();
 document.getElementById('previewRow').style.display = 'none';
 setMode('add');
 document.getElementById('userModal').classList.add('open');
 setTimeout(function(){ document.getElementById('points').focus(); }, 100);
 }

 document.getElementById('points').addEventListener('input', updatePreview);

 function closeModal() {
 document.getElementById('userModal').classList.remove('open');
 document.getElementById('username').disabled = false;
 }

 document.getElementById('userForm').addEventListener('submit', async (e) => {
 e.preventDefault();

 const userId = document.getElementById('userId').value;
 const action = document.getElementById('modalAction').value;
 const isEdit = !!userId;
 const amtField = isEdit ? document.getElementById('points') : document.getElementById('pointsAdd');
 const amt = parseInt(amtField ? amtField.value : 0) || 0;

 const data = {
 username: document.getElementById('username').value,
 isFakeUser: document.getElementById('isFakeUser').checked,
 leaderboardType: currentLeaderboard,
 action: isEdit ? action : 'set',
 [isEdit && action !== 'set' ? 'delta' : 'points']: amt
 };

 const btn = document.getElementById('submitBtn');
 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';

 try {
 const url = userId
 ? `/admin/api/leaderboard/update/${userId}`
 : '/admin/api/leaderboard/add';

 const response = await fetch(url, {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify(data)
 });

 const result = await response.json();

 if (result.success) {
 closeModal();
 loadLeaderboard();
 } else {
 alert(result.message || 'Error saving user');
 }
 } catch (error) {
 console.error('Error:', error);
 alert('Network error. Please try again.');
 } finally {
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-save"></i> Save';
 }
 });

 async function deleteUser(userId) {
 if (!confirm('Are you sure you want to delete this user from the leaderboard?')) {
 return;
 }

 try {
 const response = await fetch(`/admin/api/leaderboard/delete/${userId}?type=${currentLeaderboard}`, {
 method: 'POST'
 });

 const result = await response.json();

 if (result.success) {
 loadLeaderboard();
 } else {
 alert(result.message || 'Error deleting user');
 }
 } catch (error) {
 console.error('Error:', error);
 alert('Network error. Please try again.');
 }
 }

 // Close modal on outside click
 document.getElementById('userModal').addEventListener('click', (e) => {
 if (e.target.id === 'userModal') {
 closeModal();
 }
 });

 // ==================== REFERRAL AUDIT FUNCTIONS ====================

 // Show/hide referral audit button based on leaderboard type
 function updateAuditButton() {
 const auditBtn = document.getElementById('referralAuditBtn');
 if (currentLeaderboard === 'global') {
 auditBtn.style.display = 'none';
 } else {
 auditBtn.style.display = 'inline-flex';
 }
 }

 // Call updateAuditButton when leaderboard changes
 const originalLoadLeaderboard = loadLeaderboard;
 loadLeaderboard = async function() {
 await originalLoadLeaderboard();
 updateAuditButton();
 };

 // Open Referral Audit Modal
 async function openReferralAudit() {
 if (currentLeaderboard === 'global') {
 alert('Referral audit is only available for quest leaderboards');
 return;
 }

 document.getElementById('referralAuditModal').classList.add('open');
 document.getElementById('auditLoading').style.display = 'block';
 document.getElementById('auditContent').style.display = 'none';

 try {
 const response = await fetch(`/admin/api/quests/${currentLeaderboard}/referral-audit`);
 const result = await response.json();

 if (result.success) {
 renderReferralAudit(result);
 document.getElementById('auditContent').style.display = 'block';
 } else {
 alert(result.message || 'Error loading referral audit');
 closeReferralAuditModal();
 }
 } catch (error) {
 console.error('Error:', error);
 alert('Network error. Please try again.');
 closeReferralAuditModal();
 } finally {
 document.getElementById('auditLoading').style.display = 'none';
 }
 }

 function renderReferralAudit(data) {
 // Render overall stats
 const statsHtml = `
 <div class="audit-stat-card">
 <div class="audit-stat-value">${data.overallStats.totalUsersWithReferrals}</div>
 <div class="audit-stat-label">Users with Referrals</div>
 </div>
 <div class="audit-stat-card">
 <div class="audit-stat-value">${data.overallStats.totalReferralXpAwarded.toLocaleString()}</div>
 <div class="audit-stat-label">Total Referral XP</div>
 </div>
 <div class="audit-stat-card warning">
 <div class="audit-stat-value">${data.overallStats.totalSuspiciousReferrals}</div>
 <div class="audit-stat-label">Suspicious Referrals</div>
 </div>
 <div class="audit-stat-card warning">
 <div class="audit-stat-value">${data.overallStats.usersWithSuspiciousReferrals}</div>
 <div class="audit-stat-label">Users with Suspicious</div>
 </div>
 `;
 document.getElementById('auditStats').innerHTML = statsHtml;

 // Render user list
 const userListHtml = data.users.map(user => {
 const tgDisplay = user.telegramConnected
 ? (user.telegramUsername ? `<span class="tg-username">@${user.telegramUsername}</span>` : '<span class="status-badge badge-pending">TG: No Username</span>')
 : '<span class="status-badge badge-unverified">No TG</span>';

 return `
 <div class="audit-user-card ${user.suspiciousReferrals > 0 ? 'has-suspicious' : ''}">
 <div class="audit-user-header">
 <div>
 <span class="audit-user-name">${user.username}</span>
 ${tgDisplay}
 </div>
 <div class="audit-user-stats">
 <span><i class="fas fa-coins"></i> ${user.totalXp.toLocaleString()} XP</span>
 <span><i class="fas fa-gift"></i> +${(user.referralJoinBonus + user.referralCompleteBonus).toLocaleString()} Ref XP</span>
 ${user.suspiciousReferrals > 0 ?
 `<span style="color: #FF6B35;"><i class="fas fa-exclamation-triangle"></i> ${user.suspiciousReferrals} suspicious</span>` : ''}
 </div>
 </div>
 <div style="display: flex; justify-content: space-between; align-items: center;">
 <div style="font-size: 0.85rem; color: #888;">
 <span><i class="fas fa-sign-in-alt"></i> ${user.referralsJoinedCount} joined</span>
 <span style="margin-left: 1rem;"><i class="fas fa-check-circle"></i> ${user.referralsCompletedCount} completed</span>
 </div>
 <button class="referral-btn" onclick="viewUserReferrals('${user.userId}', '${user.username}')">
 <i class="fas fa-eye"></i> View Details
 </button>
 </div>
 </div>
 `}).join('');

 document.getElementById('auditUserList').innerHTML = userListHtml || '<p style="color: #888; text-align: center;">No users with referral bonuses found</p>';
 }

 function closeReferralAuditModal() {
 document.getElementById('referralAuditModal').classList.remove('open');
 }

 // View individual user's referrals
 async function viewUserReferrals(userId, username) {
 document.getElementById('userReferralsModal').classList.add('open');
 document.getElementById('userReferralsTitle').innerHTML = `<i class="fas fa-user-friends"></i> ${username}'s Referrals`;
 document.getElementById('userReferralsLoading').style.display = 'block';
 document.getElementById('userReferralsContent').style.display = 'none';

 try {
 const response = await fetch(`/admin/api/quests/${currentLeaderboard}/users/${userId}/referrals`);
 const result = await response.json();

 if (result.success) {
 renderUserReferrals(result);
 document.getElementById('userReferralsContent').style.display = 'block';
 } else {
 alert(result.message || 'Error loading referral details');
 closeUserReferralsModal();
 }
 } catch (error) {
 console.error('Error:', error);
 alert('Network error. Please try again.');
 closeUserReferralsModal();
 } finally {
 document.getElementById('userReferralsLoading').style.display = 'none';
 }
 }

 function renderUserReferrals(data) {
 // Render summary stats
 const statsHtml = `
 <div class="audit-stat-card">
 <div class="audit-stat-value">${data.summary.totalReferrals}</div>
 <div class="audit-stat-label">Total Referrals</div>
 </div>
 <div class="audit-stat-card">
 <div class="audit-stat-value">${data.summary.telegramVerificationRate}%</div>
 <div class="audit-stat-label">TG Verified</div>
 </div>
 <div class="audit-stat-card">
 <div class="audit-stat-value">${data.summary.questCompletionRate}%</div>
 <div class="audit-stat-label">Quest Completed</div>
 </div>
 <div class="audit-stat-card warning">
 <div class="audit-stat-value">${data.summary.suspiciousCount}</div>
 <div class="audit-stat-label">Suspicious</div>
 </div>
 `;
 document.getElementById('userReferralStats').innerHTML = statsHtml;

 // Update counts
 document.getElementById('joinedCount').textContent = data.referralsJoined.length;
 document.getElementById('completedCount').textContent = data.referralsCompleted.length;

 // Render referrals joined
 const joinedHtml = data.referralsJoined.map(ref => {
 // Flag suspicious: no TG, no username, or 0% progress
 const isSuspicious = !ref.telegramConnected || !ref.telegramUsername || ref.questProgress === 0;
 const tgDisplay = ref.telegramConnected
 ? (ref.telegramUsername ? `@${ref.telegramUsername}` : '<span style="color:#FFC107;">No Username</span>')
 : '<span style="color:#FF5252;">Not Connected</span>';

 return `
 <div class="referral-item ${isSuspicious ? 'suspicious' : ''}">
 <div class="referral-info">
 <span class="referral-username">${ref.username}</span>
 <div class="referral-badges">
 <span class="status-badge ${ref.telegramConnected && ref.telegramUsername ? 'badge-verified' : 'badge-unverified'}">
 TG: ${tgDisplay}
 </span>
 ${ref.isEmailVerified ?
 '<span class="status-badge badge-verified">Email</span>' :
 '<span class="status-badge badge-unverified">No Email</span>'}
 ${ref.questStatus === 'completed' ?
 `<span class="status-badge badge-completed">Done (${ref.tasksCompleted}/${ref.totalTasks} tasks)</span>` :
 `<span class="status-badge badge-pending">${ref.questProgress}% (${ref.tasksCompleted}/${ref.totalTasks})</span>`}
 </div>
 </div>
 <span class="referral-xp">+${ref.xpEarned} XP</span>
 </div>
 `}).join('');
 document.getElementById('referralsJoinedList').innerHTML = joinedHtml || '<p style="color: #888; text-align: center; padding: 1rem;">No referrals joined</p>';

 // Render referrals completed
 const completedHtml = data.referralsCompleted.map(ref => {
 const isSuspicious = !ref.telegramConnected || !ref.telegramUsername;
 const tgDisplay = ref.telegramConnected
 ? (ref.telegramUsername ? `@${ref.telegramUsername}` : '<span style="color:#FFC107;">No Username</span>')
 : '<span style="color:#FF5252;">Not Connected</span>';

 return `
 <div class="referral-item ${isSuspicious ? 'suspicious' : ''}">
 <div class="referral-info">
 <span class="referral-username">${ref.username}</span>
 <div class="referral-badges">
 <span class="status-badge ${ref.telegramConnected && ref.telegramUsername ? 'badge-verified' : 'badge-unverified'}">
 TG: ${tgDisplay}
 </span>
 ${ref.isEmailVerified ?
 '<span class="status-badge badge-verified">Email</span>' :
 '<span class="status-badge badge-unverified">No Email</span>'}
 </div>
 </div>
 <span class="referral-xp">+${ref.xpEarned} XP</span>
 </div>
 `}).join('');
 document.getElementById('referralsCompletedList').innerHTML = completedHtml || '<p style="color: #888; text-align: center; padding: 1rem;">No referrals completed</p>';
 }

 function closeUserReferralsModal() {
 document.getElementById('userReferralsModal').classList.remove('open');
 }

 // Close modals on outside click
 document.getElementById('referralAuditModal').addEventListener('click', (e) => {
 if (e.target.id === 'referralAuditModal') {
 closeReferralAuditModal();
 }
 });

 document.getElementById('userReferralsModal').addEventListener('click', (e) => {
 if (e.target.id === 'userReferralsModal') {
 closeUserReferralsModal();
 }
 });
 </script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
