<script>
function showToast(msg, type) {
 var existing = document.getElementById('globalToast');
 if (existing) existing.remove();
 var t = document.createElement('div');
 t.id = 'globalToast';
 var bg = type === 'error' ? 'rgba(239,68,68,.95)' : type === 'warning' ? 'rgba(245,158,11,.95)' : 'rgba(94,194,19,.95)';
 var icon = type === 'error' ? 'fa-times-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-check-circle';
 t.style.cssText = 'position:fixed;top:1.25rem;left:50%;transform:translateX(-50%) translateY(-120%);background:' + bg + ';color:#fff;padding:.85rem 1.5rem;border-radius:14px;font-size:.9rem;font-weight:700;font-family:Outfit,sans-serif;z-index:99999;display:flex;align-items:center;gap:.6rem;box-shadow:0 8px 32px rgba(0,0,0,.4);transition:transform .35s cubic-bezier(.34,1.56,.64,1);max-width:90vw;text-align:center';
 t.innerHTML = '<i class="fas ' + icon + '"></i><span>' + msg + '</span>';
 document.body.appendChild(t);
 requestAnimationFrame(function() {
 requestAnimationFrame(function() { t.style.transform = 'translateX(-50%) translateY(0)'; });
 });
 setTimeout(function() {
 t.style.transform = 'translateX(-50%) translateY(-120%)';
 setTimeout(function() { if (t.parentNode) t.remove(); }, 400);
 }, type === 'error' ? 5000 : 3500);
}

// Countdown
<% if (bounty.endDate && new Date() < new Date(bounty.endDate)) { %>
const endMs = <%= new Date(bounty.endDate).getTime() %>;
const cdEl = document.getElementById('cdVal');
function tickCD() {
 const ms = endMs - Date.now();
 if (ms <= 0) { if(cdEl) cdEl.textContent='Ended'; return; }
 const d=Math.floor(ms/86400000), h=Math.floor((ms%86400000)/3600000),
 m=Math.floor((ms%3600000)/60000), s=Math.floor((ms%60000)/1000);
 if(cdEl) {
 cdEl.textContent = d>0 ? d+'d '+h+'h '+m+'m' : h+'h '+m+'m '+s+'s';
 if(ms<3600000) cdEl.classList.add('urgent');
 }
}
tickCD(); setInterval(tickCD, 1000);
<% } %>

// Submit form
const form = document.getElementById('submitForm');
function openSubmitDialog() {
 const dialog = document.getElementById('submitDialog');
 if (dialog && !dialog.open) dialog.showModal();
}
const submitDialog = document.getElementById('submitDialog');
if (submitDialog) submitDialog.addEventListener('click', function(e) { if (e.target === submitDialog) submitDialog.close(); });
if (form) {
 form.addEventListener('submit', async function(e) {
 e.preventDefault();
 const btn = document.getElementById('submitBtn');
 btn.disabled = true;
 btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
 try {
 const res = await fetch('/dashboard/bounties/internal/<%= bounty._id %>/submit', {
 method: 'POST',
 headers: { 'Content-Type': 'application/json' },
 body: JSON.stringify({
 title: document.getElementById('subTitle').value,
 description: document.getElementById('subDesc').value,
 submissionUrl: document.getElementById('subUrl').value
 })
 });
 const data = await res.json();
 if (data.success) {
 showToast('Submission received!', 'success');
 setTimeout(function() { location.reload(); }, 1200);
 } else {
 showToast(data.message || 'Error submitting', 'error');
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit';
 }
 } catch(err) {
 showToast('Network error. Please try again.', 'error');
 btn.disabled = false;
 btn.innerHTML = '<i class="fas fa-paper-plane"></i> Submit';
 }
 });
}
</script>
<%- include('../partials/whatsapp-float') %>
</body>
</html>
